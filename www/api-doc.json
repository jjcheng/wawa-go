    "/auth/v1/login": {
      "post": {
        "description": "Authenticates a user with their phone number and password.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "password": {
                    "description": "user's password",
                    "type": "string"
                  },
                  "phone_number": {
                    "description": "user's full phone number",
                    "example": "6590909090",
                    "type": "string"
                  }
                },
                "required": [
                  "phone_number",
                  "password"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "description": "the actual API returned data, empty if not success",
