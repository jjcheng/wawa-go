                        "description": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "entry_date": {
                          "example": "2025-10-01T08:08:00Z",
                          "format": "date-time",
                          "type": "string"
                        },
                        "id": {
                          "example": 1,
                          "format": "int32",
                          "type": "integer"
                        },
                        "last_update": {
                          "example": "2025-10-01T08:08:00Z",
                          "format": "date-time",
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "phone_number": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "entry_date",
                        "last_update"
                      ],
                      "type": "object"
                    },
                    "status_code": {
                      "description": "http status code",
                      "example": 200,
                      "format": "int32",
                      "type": "integer"
                    },
                    "success": {
                      "description": "is request is success",
                      "example": true,
                      "type": "boolean"
                    },
                    "time_taken": {
                      "description": "time taken in miliseconds",
                      "example": 100,
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "success",
                    "status_code",
                    "time_taken"
                  ],
                  "type": "object"
